{
  "name": "meu-fluxo-android",
  "version": "0.1.0",
  "private": true,
  "description": "Meu Fluxo Android - Capacitor + ML Kit",
  "type": "module",
  "scripts": {
    "prepare:web": "node scripts/prepare-web.mjs",
    "check:native": "node --check src/native.mjs && node --check scripts/prepare-web.mjs",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:debug": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "8.0.0",
    "@capacitor/android": "8.0.0",
    "@capacitor/app": "8.0.0",
    "@capacitor/filesystem": "8.0.0",
    "@capacitor-mlkit/barcode-scanning": "8.2.2",
    "@capacitor-mlkit/document-scanner": "8.2.2",
    "@capacitor-mlkit/text-recognition": "8.2.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.0.0",
    "esbuild": "0.25.12"
  }
}
